{
  "name": "dsh-harmonyos-hiboard",
  "version": "0.2.0",
  "description": "Push DeepSeek Harness (dsh) task results to Huawei HarmonyOS assistant-today service cards. Fixed for dsh 0.1.5 / cordis 4, with documentation of the card rendering contract.",
  "author": "Jim Chen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaybeMeibeMaybi/dsh-harmonyos-hiboard.git"
  },
