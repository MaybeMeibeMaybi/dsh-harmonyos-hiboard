{
  "name": "dsh-harmonyos-hiboard",
  "version": "0.7.0",
  "description": "把 dsh 的任务结果推送到华为鸿蒙负一屏服务卡片；设置页可直接粘贴关联指令；内置推送兜底，默认开启。 ｜ Push dsh task results to Huawei HarmonyOS assistant-today cards, with a settings card and a push safety net that is on by default.",
  "author": "Jim Chen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaybeMeibeMaybi/dsh-harmonyos-hiboard.git"
  },
  "bugs": {
    "url": "https://github.com/MaybeMeibeMaybi/dsh-harmonyos-hiboard/issues"
  },
  "homepage": "https://github.com/MaybeMeibeMaybi/dsh-harmonyos-hiboard#readme",
  "type": "module",
  "main": "src/lib/index.js",
  "exports": {
    ".": "./src/lib/index.js",
    "./client": "./src/lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "docs",
    "screenshots.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "harmonyos",
    "harmonyos-next",
    "hiboard",
    "assistant-today",
    "negative-one-screen",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "service-card",
    "notification",
    "markdown",
    "cordis"
  ],
  "dsh": {
    "bundle": {
      "patch": "./src/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "test": "node --test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc.1 <5.0.0-0",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.0.0-rc.1 <4.0.0-0"
  }
}
