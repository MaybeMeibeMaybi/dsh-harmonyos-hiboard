{
  "name": "dsh-harmonyos-hiboard",
  "version": "0.10.4",
  "description": "把DSH的任务结果，以服务卡片形式推送到华为鸿蒙负一屏 ｜ Push DSH task results to the Huawei HarmonyOS assistant-today screen as service cards.",
  "author": "Jim Chen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaybeMeibeMaybi/dsh-harmonyos-hiboard.git"
  },
  "bugs": {
    "url": "https://github.com/MaybeMeibeMaybi/dsh-harmonyos-hiboard/issues"
  },
  "homepage": "https://github.com/MaybeMeibeMaybi/dsh-harmonyos-hiboard#readme",
  "type": "module",
  "main": "src/lib/index.js",
  "exports": {
    ".": "./src/lib/index.js",
    "./client": "./src/lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "docs",
    "screenshots.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "harmonyos",
    "harmonyos-next",
    "hiboard",
    "assistant-today",
    "negative-one-screen",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "service-card",
    "notification",
    "markdown",
    "cordis"
  ],
  "dsh": {
    "bundle": {
      "patch": "./src/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "test": "node --test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc.1 <5.0.0-0",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.0.0-rc.1 <4.0.0-0"
  }
}
