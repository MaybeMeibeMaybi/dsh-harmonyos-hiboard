# ---- Node / npm ----
node_modules/
npm-debug.log*
pnpm-debug.log*
yarn-error.log*
package-lock.json
pnpm-lock.yaml

# ---- Logs and runtime state ----
*.log
logs/
# 插件运行时产物（审计/状态/落盘），一律不进仓库
*.jsonl

# ---- Secrets: never commit credentials ----
# The HiBoard auth code goes in ~/.dsh/profiles/web/cordis.patch.yml, NOT in this repo.
.env
.env.*
*.pem
*.key
*.crt
*.cer
*dsh_aliyun*
credential*

# ---- Editor / OS ----
.vscode/
.idea/
Thumbs.db
desktop.ini
*.swp

# ---- Local scratch ----
tmp/
temp/
*.bak-*
!src/lib/index.js.upstream-backup

# ---- secrets / credentials (never commit) ----
secrets/
*register-key*
*.pfx
*.p12
ca-key.pem
gateway.env
# 发布前扫描用的针脚文件（publish.ps1 读它做凭据比对）：只存在本机，永不入库
privacy-secrets.local.json
*secrets*.local.json
# CA certs for phone install are safe to publish, but keep local copies out:
!ca-for-phone/*.cer
!ca-for-phone/*.crt
