# ---- Node / npm ----
node_modules/
npm-debug.log*
pnpm-debug.log*
yarn-error.log*
package-lock.json
pnpm-lock.yaml

# ---- Logs and runtime state ----
*.log
logs/

# ---- Secrets: never commit credentials ----
# The HiBoard auth code goes in ~/.dsh/profiles/web/cordis.patch.yml, NOT in this repo.
.env
.env.*
*.pem
*.key
*dsh_aliyun*
credential*

# ---- Editor / OS ----
.vscode/
.idea/
Thumbs.db
desktop.ini
*.swp

# ---- Local scratch ----
tmp/
temp/
*.bak-*
!src/lib/index.js.upstream-backup

# ---- secrets / credentials (never commit) ----
secrets/
*register-key*
*.pfx
*.p12
ca-key.pem
gateway.env
# CA certs for phone install are safe to publish, but keep local copies out:
!ca-for-phone/*.cer
!ca-for-phone/*.crt
